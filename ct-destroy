#!/bin/bash
# ct-destroy - remove an LXC container created by ct-create
# Usage: ct-destroy ctN --yes [--force] [--purge] [--dry-run|-n]
#   --yes    required confirmation (no interactive prompt)
#   --force  stop the container first if running
#   --purge  also remove unit file and host ssh user (default keeps them)
set -euo pipefail

LXCDIR=/var/lib/lxc
CONFDIR=/etc/ct-create

# DNS vars (for alias CNAME removal)
CT_GCLOUD_CONFIG=
CT_GCP_DNS_ZONE_NAME=dev-lan
CT_DNS_DOMAIN=dev.lan
[ -f "$CONFDIR/defaults.conf" ] && . "$CONFDIR/defaults.conf"

die()  { echo "ERROR: $*" >&2; exit 1; }
info() { echo ">>> $*"; }

CT=""; YES=0; FORCE=0; PURGE=0; DRYRUN=0
while [ $# -gt 0 ]; do
  case "$1" in
    --yes)        YES=1; shift ;;
    --force)      FORCE=1; shift ;;
    --purge)      PURGE=1; shift ;;
    --dry-run|-n) DRYRUN=1; shift ;;
    ct[0-9]*)     CT="$1"; shift ;;
    *) die "unknown argument: $1" ;;
  esac
done
[ -n "$CT" ] || die "container name required (ctN)"
[[ "$CT" =~ ^ct[0-9]+$ ]] || die "invalid name: $CT"
[ "$(id -u)" = 0 ] || die "must run as root"
[ -e "$LXCDIR/$CT" ] || die "$LXCDIR/$CT does not exist"

run() { if [ "$DRYRUN" = 1 ]; then echo "DRY: $*"; else "$@"; fi }

RUNNING=0
lxc-info -n "$CT" -s 2>/dev/null | grep -q RUNNING && RUNNING=1
if [ "$RUNNING" = 1 ] && [ "$FORCE" = 0 ]; then
  die "$CT is running (use --force to stop it)"
fi

ALIAS=""
[ -f "$LXCDIR/$CT/alias" ] && ALIAS=$(cat "$LXCDIR/$CT/alias")

cat <<EOF
=== ct-destroy plan ===
Name:    $CT $( [ "$RUNNING" = 1 ] && echo "(RUNNING - will stop)" )
Rootfs:  $LXCDIR/$CT (delete)
Alias:    ${ALIAS:-<none>}${ALIAS:+ (CNAME $ALIAS.$CT_DNS_DOMAIN will be removed)}
Unit:    $CT.service $( [ "$PURGE" = 1 ] && echo "(remove)" || echo "(disable, keep file)" )
User:    $CT $( [ "$PURGE" = 1 ] && echo "(remove)" || echo "(keep)" )
=======================
EOF

if [ "$DRYRUN" = 1 ]; then info "dry-run: no changes made"; exit 0; fi
[ "$YES" = 1 ] || die "refusing without --yes"

if systemctl list-unit-files "$CT.service" --no-legend 2>/dev/null | grep -q .; then
  run systemctl disable --now "$CT.service" 2>/dev/null || true
elif [ "$RUNNING" = 1 ]; then
  run lxc-stop -n "$CT"
fi

# remove alias CNAME (keep A record)
if [ -n "$ALIAS" ] && [ -n "$CT_GCLOUD_CONFIG" ] && command -v gcloud >/dev/null 2>&1; then
  info "removing CNAME $ALIAS.$CT_DNS_DOMAIN"
  run gcloud dns record-sets delete "$ALIAS.$CT_DNS_DOMAIN." --type=CNAME \
    --zone="$CT_GCP_DNS_ZONE_NAME" --configuration="$CT_GCLOUD_CONFIG" >/dev/null 2>&1 \
    || echo "WARN: CNAME removal failed (may not exist)" >&2
fi

# delete rootfs: btrfs subvolume if it is one, else rm -rf (legacy dirs)
if btrfs subvolume show "$LXCDIR/$CT/rootfs" >/dev/null 2>&1; then
  run btrfs subvolume delete "$LXCDIR/$CT/rootfs"
else
  run rm -rf "$LXCDIR/$CT/rootfs"
fi
run rm -f "$LXCDIR/$CT/config" "$LXCDIR/$CT/alias"
if btrfs subvolume show "$LXCDIR/$CT" >/dev/null 2>&1; then
  run btrfs subvolume delete "$LXCDIR/$CT"
else
  run rm -rf "$LXCDIR/$CT"
fi

if [ "$PURGE" = 1 ]; then
  run rm -f "/etc/systemd/system/$CT.service"
  run systemctl daemon-reload
  getent passwd "$CT" >/dev/null && run userdel "$CT"
fi

info "$CT destroyed$( [ "$PURGE" = 1 ] && echo " (purged)" )"
