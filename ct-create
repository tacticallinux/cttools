#!/bin/bash
# ct-create - provision a new LXC container (ipvlan L3s, unprivileged, btrfs)
# Usage: ct-create [--name ctN] [--config <name>] [--alias <alias>] [--dry-run|-n]
#   name/IP auto-derived (lowest free N; ctN = 10.130.0.N) unless --name given
set -euo pipefail

CONFDIR=/etc/ct-create
LXCDIR=/var/lib/lxc
UNIT_TEMPLATE=$CONFDIR/ctN.service.template
IP_PREFIX=10.130.0
CT_MAX=15           # ct1..ct15 -> 10.130.0.1-15 (/28 alias)
IDMAP_START=231072
IDMAP_SIZE=65536
CT_SSH_UID=1005
CT_SSH_GID=1005
CT_SCRIPTS_TARGET=/etc/ct-create/scripts   # inside the CT

die()  { echo "ERROR: $*" >&2; exit 1; }
warn() { echo "WARN: $*" >&2; }
info() { echo ">>> $*"; }

# ---------- args ----------
CT=""; NAMED_CONFIG=""; ALIAS_ARG=""; DRYRUN=0
while [ $# -gt 0 ]; do
  case "$1" in
    --name)       CT="${2:?--name needs ctN}"; shift 2 ;;
    --config)     NAMED_CONFIG="${2:?--config needs a name}"; shift 2 ;;
    --alias)       ALIAS_ARG="${2:?--alias needs a name}"; shift 2 ;;
    --dry-run|-n) DRYRUN=1; shift ;;
    *) die "unknown argument: $1 (usage: ct-create [--name ctN] [--config <name>] [--alias <alias>] [--dry-run|-n])" ;;
  esac
done

run() {  # execute or echo depending on dry-run
  if [ "$DRYRUN" = 1 ]; then echo "DRY: $*"; else "$@"; fi
}

# ---------- config (defaults -> named) ----------
CT_CODENAME=trixie
CT_MIRROR=http://deb.debian.org/debian
CT_PACKAGES=systemd,systemd-sysv,systemd-timesyncd,iputils-ping,nano,net-tools,less,lrzsz,rsync,procps,wget,curl,locales,tzdata,iproute2,bash-completion
CT_MEM_MAX=512M
CT_MEM_HIGH=448M
CT_CPU_QUOTA=50%
CT_CPU_WEIGHT=
CT_TZ=America/Los_Angeles
CT_TEMPLATE=
CT_HOOK_SCRIPTS_DIR=/etc/ct-create/scripts   # host source dir for hook scripts
CT_HOOKS_CHROOT=()
CT_HOOKS_ATTACH=()
CT_ALIAS=
CT_GCLOUD_CONFIG=            # named gcloud configuration; empty = skip all DNS ops
CT_GCP_DNS_ZONE_NAME=dev-lan
CT_DNS_DOMAIN=dev.lan

[ -f "$CONFDIR/defaults.conf" ] && . "$CONFDIR/defaults.conf"
if [ -n "$NAMED_CONFIG" ]; then
  [ -f "$CONFDIR/$NAMED_CONFIG.conf" ] || die "named config not found: $CONFDIR/$NAMED_CONFIG.conf"
  . "$CONFDIR/$NAMED_CONFIG.conf"
fi
[ -n "$ALIAS_ARG" ] && CT_ALIAS="$ALIAS_ARG"    # CLI wins over configs

# ---------- validation ----------
[ "$(id -u)" = 0 ] || die "must run as root"
[ -f "$UNIT_TEMPLATE" ] || die "unit template missing: $UNIT_TEMPLATE"

# btrfs hard requirement
FSTYPE=$(findmnt -n -o FSTYPE --target "$LXCDIR")
[ "$FSTYPE" = btrfs ] || die "$LXCDIR is not on btrfs (found: $FSTYPE)"

# >=10% pool space free
USEPCT=$(df --output=pcent "$LXCDIR" | tail -1 | tr -dc 0-9)
[ "$USEPCT" -le 90 ] || die "less than 10% free on $LXCDIR (${USEPCT}% used)"

# ---------- N / name / IP ----------
if [ -n "$CT" ]; then
  [[ "$CT" =~ ^ct([1-9][0-9]?)$ ]] || die "name must be ctN (N=1..$CT_MAX)"
  N=${BASH_REMATCH[1]}
  [ "$N" -ge 1 ] && [ "$N" -le "$CT_MAX" ] || die "N must be 1..$CT_MAX"
  [ ! -e "$LXCDIR/$CT" ] || die "$LXCDIR/$CT already exists"
else
  N=""
  for i in $(seq 1 $CT_MAX); do
    [ ! -e "$LXCDIR/ct$i" ] && { N=$i; break; }
  done
  [ -n "$N" ] || die "no free CT slot (ct1..ct$CT_MAX all exist)"
  CT="ct$N"
fi
CT_IP="$IP_PREFIX.$N"

systemctl is-active --quiet "$CT.service" 2>/dev/null && die "$CT.service is already active"

# template sanity
if [ -n "$CT_TEMPLATE" ]; then
  [ -e "$CT_TEMPLATE" ] || die "template not found: $CT_TEMPLATE"
fi

# hook validation: resolve source path (relative -> CT_HOOK_SCRIPTS_DIR)
resolve_hook() {  # $1=scriptname -> echoes host path
  case "$1" in
    */*) echo "$1" ;;
    *)   echo "$CT_HOOK_SCRIPTS_DIR/$1" ;;
  esac
}
for entry in "${CT_HOOKS_CHROOT[@]}" "${CT_HOOKS_ATTACH[@]}"; do
  eval set -- $entry
  src=$(resolve_hook "$1")
  [ -x "$src" ] || die "hook script not executable: $src"
done

# gcloud availability (soft)
GCLOUD_OK=0
if [ -n "$CT_GCLOUD_CONFIG" ]; then
  if command -v gcloud >/dev/null 2>&1; then
    GCLOUD_OK=1
  else
    warn "gcloud not found - skipping DNS updates"
  fi
fi

# ---------- idmap ----------
IDMAP_BASE=$((IDMAP_START + (N - 1) * IDMAP_SIZE))
NEED_END=$((IDMAP_BASE + IDMAP_SIZE))
for f in /etc/subuid /etc/subgid; do
  ENTRY=$(grep '^root:' "$f" || true)
  [ -n "$ENTRY" ] || die "no root entry in $f"
  S=$(echo "$ENTRY" | cut -d: -f2); C=$(echo "$ENTRY" | cut -d: -f3)
  if [ "$IDMAP_BASE" -lt "$S" ] || [ "$NEED_END" -gt $((S + C)) ]; then
    NEWCOUNT=$((NEED_END - S))
    info "extending root range in $f to $S:$NEWCOUNT"
    run sed -i "s/^root:$S:$C\$/root:$S:$NEWCOUNT/" "$f"
  fi
done

ROOTFS=$LXCDIR/$CT/rootfs
HOSTSHORT=$(hostname -s)
CT_FQDN="$CT.$HOSTSHORT.$CT_DNS_DOMAIN"
ALIAS_FQDN=""
[ -n "$CT_ALIAS" ] && ALIAS_FQDN="$CT_ALIAS.$CT_DNS_DOMAIN"

# ---------- plan summary ----------
cat <<EOF
=== ct-create plan ===
Name:       $CT
IP:         $CT_IP/32 (ipvlan l3s on ens4)
FQDN:       $CT_FQDN $( [ "$GCLOUD_OK" = 1 ] && echo "(A record via gcloud:$CT_GCLOUD_CONFIG zone:$CT_GCP_DNS_ZONE_NAME)" || echo "(no DNS update)" )
Alias:       ${CT_ALIAS:-<none>}${ALIAS_FQDN:+ -> CNAME $ALIAS_FQDN}
idmap:      u/g 0 $IDMAP_BASE $IDMAP_SIZE
Rootfs:     $ROOTFS $( [ -n "$CT_TEMPLATE" ] && echo "(from template: $CT_TEMPLATE)" || echo "(debootstrap $CT_CODENAME minbase)" )
Packages:   $CT_PACKAGES
Mem:        High=$CT_MEM_HIGH Max=$CT_MEM_MAX   CPU: Quota=$CT_CPU_QUOTA${CT_CPU_WEIGHT:+ Weight=$CT_CPU_WEIGHT}
TZ:         $CT_TZ
Hooks:      chroot=${CT_HOOKS_CHROOT[*]:-<none>} | attach=${CT_HOOKS_ATTACH[*]:-<none>}
Configs:    defaults${NAMED_CONFIG:+ + $NAMED_CONFIG.conf}
======================
EOF
[ "$DRYRUN" = 1 ] && info "dry-run: no changes made beyond plan above"

# ---------- rootfs ----------
run btrfs subvolume create "$LXCDIR/$CT" >/dev/null

if [ -n "$CT_TEMPLATE" ]; then
  if [ -d "$CT_TEMPLATE" ]; then
    info "snapshotting template subvolume"
    run btrfs subvolume snapshot "$CT_TEMPLATE" "$ROOTFS" >/dev/null
  else
    info "extracting template tarball"
    run mkdir -p "$ROOTFS"
    case "$CT_TEMPLATE" in
      *.tar.zst) run tar --zstd -xf "$CT_TEMPLATE" -C "$ROOTFS" ;;
      *.tar.gz|*.tgz) run tar -xzf "$CT_TEMPLATE" -C "$ROOTFS" ;;
      *.tar) run tar -xf "$CT_TEMPLATE" -C "$ROOTFS" ;;
      *) die "unrecognized template type: $CT_TEMPLATE" ;;
    esac
  fi
else
  info "running debootstrap ($CT_CODENAME)"
  run debootstrap --variant=minbase --include="$CT_PACKAGES" \
      "$CT_CODENAME" "$ROOTFS" "$CT_MIRROR"
fi

# ---------- in-rootfs prep ----------
if [ "$DRYRUN" = 1 ]; then
  info "dry-run: would stamp hostname/network/hosts/TZ/NTP, install resolved, copy+run hooks, DNS upserts, write config+unit, enable+start"
  exit 0
fi

echo "$CT" > "$ROOTFS/etc/hostname"

# /etc/hosts (own IP + FQDN + optional alias names)
cat > "$ROOTFS/etc/hosts" <<EOF
127.0.0.1 localhost
$CT_IP $CT $CT_FQDN${CT_ALIAS:+ $ALIAS_FQDN $CT_ALIAS}
EOF

# network
mkdir -p "$ROOTFS/etc/systemd/network"
cat > "$ROOTFS/etc/systemd/network/eth0.network" <<EOF
[Match]
Name=eth0

[Network]
Address=$CT_IP/32
DNS=169.254.169.254

[Route]
Destination=0.0.0.0/0
Scope=link
EOF

# TZ + NTP + locale
ln -sf "/usr/share/zoneinfo/$CT_TZ" "$ROOTFS/etc/localtime"
echo "$CT_TZ" > "$ROOTFS/etc/timezone"
sed -i 's/^#\?NTP=.*/NTP=169.254.169.254/' "$ROOTFS/etc/systemd/timesyncd.conf" 2>/dev/null || true
echo 'LANG=C.UTF-8' > "$ROOTFS/etc/default/locale"

# alias prompt
if [ -n "$CT_ALIAS" ]; then
  cat > "$ROOTFS/etc/profile.d/ct-alias.sh" <<EOF
export CT_ALIAS=$CT_ALIAS
PS1='\${debian_chroot:+(\$debian_chroot)}\\u@\\h[$CT_ALIAS]:\\w\\\$ '
EOF
fi

if [ -z "$CT_TEMPLATE" ]; then
  info "fresh-build prep (resolved install, service enables)"
  echo 'nameserver 169.254.169.254' > "$ROOTFS/etc/resolv.conf"
  chroot "$ROOTFS" /bin/bash <<'EOSH'
set -e
printf '#!/bin/sh\nexit 101\n' > /usr/sbin/policy-rc.d && chmod +x /usr/sbin/policy-rc.d
apt-get update -qq
apt-get install -y -qq systemd-resolved
rm /usr/sbin/policy-rc.d
systemctl enable systemd-networkd systemd-resolved systemd-timesyncd
passwd -d root >/dev/null
printf 'cd /root\n[ -f ~/.bashrc ] && . ~/.bashrc\n' > /root/.bash_profile
ln -sf /lib/systemd/system/poweroff.target /etc/systemd/system/reboot.target
EOSH
fi

# ---------- copy hook scripts into CT ----------
if [ "${#CT_HOOKS_CHROOT[@]}" -gt 0 ] || [ "${#CT_HOOKS_ATTACH[@]}" -gt 0 ]; then
  mkdir -p "$ROOTFS$CT_SCRIPTS_TARGET"
  for entry in "${CT_HOOKS_CHROOT[@]}" "${CT_HOOKS_ATTACH[@]}"; do
    eval set -- $entry
    src=$(resolve_hook "$1")
    cp "$src" "$ROOTFS$CT_SCRIPTS_TARGET/$(basename "$src")"
    chmod 755 "$ROOTFS$CT_SCRIPTS_TARGET/$(basename "$src")"
  done
fi

# ---------- chroot hooks (in order, working DNS) ----------
if [ "${#CT_HOOKS_CHROOT[@]}" -gt 0 ]; then
  SAVED=$(readlink "$ROOTFS/etc/resolv.conf" 2>/dev/null || true)
  rm -f "$ROOTFS/etc/resolv.conf"
  echo 'nameserver 169.254.169.254' > "$ROOTFS/etc/resolv.conf"
  for entry in "${CT_HOOKS_CHROOT[@]}"; do
    eval set -- $entry
    s="$CT_SCRIPTS_TARGET/$(basename "$1")"; shift
    info "running chroot hook: $s $*"
    chroot "$ROOTFS" "$s" "$@"
  done
  [ -n "$SAVED" ] && ln -sf "$SAVED" "$ROOTFS/etc/resolv.conf"
fi

# finalize resolv.conf + machine-id
ln -sf /run/systemd/resolve/stub-resolv.conf "$ROOTFS/etc/resolv.conf"
truncate -s0 "$ROOTFS/etc/machine-id"

# ---------- alias stamp ----------
[ -n "$CT_ALIAS" ] && echo "$CT_ALIAS" > "$LXCDIR/$CT/alias"

# ---------- LXC config ----------
cat > "$LXCDIR/$CT/config" <<EOF
lxc.uts.name = $CT
lxc.arch = amd64
lxc.include = /usr/share/lxc/config/common.conf
lxc.include = /usr/share/lxc/config/userns.conf
lxc.mount.auto = proc:mixed sys:ro cgroup:mixed
lxc.idmap = u 0 $IDMAP_BASE $IDMAP_SIZE
lxc.idmap = g 0 $IDMAP_BASE $IDMAP_SIZE
lxc.rootfs.path = dir:$ROOTFS
lxc.rootfs.options = idmap=container
lxc.apparmor.profile = unconfined

lxc.net.0.type = ipvlan
lxc.net.0.ipvlan.mode = l3s
lxc.net.0.link = ens4
lxc.net.0.flags = up
lxc.net.0.name = eth0
EOF

# ---------- unit ----------
CPU_WEIGHT_LINE=""
[ -n "$CT_CPU_WEIGHT" ] && CPU_WEIGHT_LINE="CPUWeight=$CT_CPU_WEIGHT"
sed -e "s/%CT%/$CT/g" \
    -e "s/%MEM_MAX%/$CT_MEM_MAX/" \
    -e "s/%MEM_HIGH%/$CT_MEM_HIGH/" \
    -e "s/%CPU_QUOTA%/$CT_CPU_QUOTA/" \
    -e "s/%CPU_WEIGHT%/$CPU_WEIGHT_LINE/" \
    "$UNIT_TEMPLATE" | sed '/^$/N;/\n$/D' > "/etc/systemd/system/$CT.service"
systemctl daemon-reload

# ---------- host ssh user ----------
if ! getent passwd "$CT" >/dev/null; then
  info "adding host user $CT"
  useradd -o -u "$CT_SSH_UID" -g "$CT_SSH_GID" -M -d / -s /bin/bash "$CT"
fi

# ---------- DNS upserts ----------
dns_upsert() {  # $1=name $2=type $3=rrdata
  gcloud dns record-sets update "$1" --type="$2" --zone="$CT_GCP_DNS_ZONE_NAME" \
    --rrdatas="$3" --ttl=300 --configuration="$CT_GCLOUD_CONFIG" >/dev/null 2>&1 \
  || gcloud dns record-sets create "$1" --type="$2" --zone="$CT_GCP_DNS_ZONE_NAME" \
    --rrdatas="$3" --ttl=300 --configuration="$CT_GCLOUD_CONFIG" >/dev/null 2>&1 \
  || warn "DNS upsert failed: $1 $2 -> $3"
}
if [ "$GCLOUD_OK" = 1 ]; then
  info "DNS: A $CT_FQDN -> $CT_IP"
  dns_upsert "$CT_FQDN." A "$CT_IP"
  if [ -n "$ALIAS_FQDN" ]; then
    info "DNS: CNAME $ALIAS_FQDN -> $CT_FQDN"
    dns_upsert "$ALIAS_FQDN." CNAME "$CT_FQDN."
  fi
fi

# ---------- start ----------
info "starting $CT.service"
systemctl enable --now "$CT.service"

info "waiting for $CT to reach RUNNING"
UP=0
for i in $(seq 1 30); do
  lxc-info -n "$CT" -s 2>/dev/null | grep -q RUNNING && { UP=1; break; }
  sleep 1
done
[ "$UP" = 1 ] || die "$CT failed to reach RUNNING within 30s - check: journalctl -u $CT.service ; lxc-start -n $CT -F -l DEBUG -o /tmp/$CT.log"

# ---------- attach hooks (in order; CT verified running, stays running) ----------
if [ "${#CT_HOOKS_ATTACH[@]}" -gt 0 ]; then
  sleep 2
  for entry in "${CT_HOOKS_ATTACH[@]}"; do
    eval set -- $entry
    s="$CT_SCRIPTS_TARGET/$(basename "$1")"; shift
    info "running attach hook: $s $*"
    lxc-attach -n "$CT" --clear-env -- "$s" "$@"
  done
fi

# ---------- summary ----------
cat <<EOF

=== $CT created ===
IP:      $CT_IP
FQDN:    $CT_FQDN${ALIAS_FQDN:+  (alias: $ALIAS_FQDN)}
idmap:   $IDMAP_BASE:$IDMAP_SIZE
Unit:    $CT.service (enabled)
Console: ssh $CT@$HOSTSHORT   or   lxc-attach -n $CT
===================
EOF
